# Navidrome — keep this file out of git (chmod 600 .env)

# Required
DOMAIN=music.example.com
# Immutable image tag from the Gitea registry (version or sha-…), not "latest"
IMAGE_TAG=1.0.0

# Music library on a network share (examples):
#   NFS:  type=nfs   o=addr=192.168.1.10,nfsvers=4.1,ro,hard   device=:/export/music
#   CIFS: type=cifs  o=addr=192.168.1.10,username=u,password=p,ro   device=//192.168.1.10/music
MUSIC_MOUNT_TYPE=nfs
MUSIC_MOUNT_O=addr=192.168.1.10,nfsvers=4.1,ro,hard
MUSIC_MOUNT_DEVICE=:/export/music

# Access control — set BOTH. Unset means localhost only (nobody gets in).
# Comma-separate multiple ranges.
IPV4_ALLOWLIST=
IPV6_ALLOWLIST=

# How often to rescan the share for new music
ND_SCANNER_SCHEDULE=@every 1h

# Optional overrides
TZ=Europe/Athens
NAVIDROME_CPU_LIMIT=2
NAVIDROME_MEMORY_LIMIT=512M
NAVIDROME_MEMORY_RESERVATION=64M
NAVIDROME_PIDS_LIMIT=256